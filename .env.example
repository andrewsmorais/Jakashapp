# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção). Nunca commite valores reais.
# Esta página não usa banco, pagamento nem chaves secretas. Só dois endereços públicos.
# São lidos no build: faça novo deploy depois de mudar.

# Página do Jakash na App Store (ex.: https://apps.apple.com/br/app/jakash/id0000000000)
NEXT_PUBLIC_APP_STORE_URL=

# Endereço do app para usar no computador, sem barra no final (ex.: https://app.jakash.app)
NEXT_PUBLIC_APP_URL=
