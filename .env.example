# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção). Nunca commite valores reais.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=              # só no servidor (rotas de API)
NEXT_PUBLIC_SITE_URL=https://www.jakash.app

# --- IA (Chat da Jaki e leitura de arquivos) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini           # opcional
AI_CHAT_DAILY_LIMIT=                    # opcional: mensagens/dia por usuário (padrão 30; MEI 60)

# --- Lembretes automáticos — ver LEMBRETES-E-IA.md ---
CRON_SECRET=                            # texto longo e aleatório; a Vercel o envia no cron
NEXT_PUBLIC_VAPID_PUBLIC_KEY=           # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                          # opcional (padrão https://www.jakash.app)
RESEND_API_KEY=                         # e-mail (Resend)
EMAIL_FROM=                             # ex.: Jakash <lembretes@jakash.app> (domínio verificado no Resend)

OPENAI_VISION_MODEL=                    # opcional (padrão: o mesmo do chat); lê PDF e foto em Importar arquivo

# --- Suporte (opcional) ---
NEXT_PUBLIC_SUPPORT_EMAIL=             # e-mail de suporte mostrado em Configurações > Fale conosco. Se vazio, aparece "Em breve".
SUPPORT_ANTHROPIC_API_KEY=            # chave da API da Claude (Anthropic) do chat de ajuda em Configurações > Fale conosco. Sem ela, o chat mostra "em breve".
SUPPORT_CHAT_MODEL=                   # opcional; padrão claude-haiku-5-5
NEXT_PUBLIC_SUPPORT_WHATSAPP=           # só números com DDI+DDD (ex.: 5512999999999). Se vazio, o link "Suporte no WhatsApp" não aparece. Lida no build: faça novo deploy ao mudar.

# --- Assinatura (Mensal R$ 19,90 e Anual R$ 159, 7 dias grátis pela Apple) ---
# Liga a compra dentro do app iOS (sem isto, a tela de planos no iPhone não vende).
NEXT_PUBLIC_IOS_IAP=1
# Ids dos produtos de assinatura na App Store Connect (se vazios, valem jakash.mensal e jakash.anual).
NEXT_PUBLIC_IAP_PRODUCT_MENSAL=
NEXT_PUBLIC_IAP_PRODUCT_ANUAL=
# Link do app na App Store (botão "Baixar na App Store" na tela de planos do site).
NEXT_PUBLIC_APP_STORE_URL=

# Compras de TESTE da Apple (TestFlight/Revisão) em produção: só liberam o app para estas contas (ids do Jakash, separados por vírgula),
# ou para todos enquanto APPLE_ALLOW_SANDBOX=1. Coloque aqui a conta demo que você passa para a Revisão da App Store.
APPLE_SANDBOX_USER_IDS=
APPLE_ALLOW_SANDBOX=
